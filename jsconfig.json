{
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2024",
    "paths": {
      "@client/*": ["foundry/client/*"],
      "@common/*": ["foundry/common/*"]
    },
    "baseUrl": "."
  },
  "exclude": ["node_modules", "**/node_modules/*"],
  "include": ["src/module.mjs", "src/**/*.mjs", "foundry/client/client.mjs", "global.d.ts"],
}

